diff --git a/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Sleep.m b/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Sleep.m
index c66dc91..de56779 100644
--- a/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Sleep.m
+++ b/node_modules/react-native-health/RCTAppleHealthKit/RCTAppleHealthKit+Methods_Sleep.m
@@ -41,5 +41,60 @@ - (void)sleep_getSleepSamples:(NSDictionary *)input callback:(RCTResponseSenderB
 
 }
 
+- (void)sleep_saveSleepSample:(NSDictionary *)input callback:(RCTResponseSenderBlock)callback
+{
+    NSDate *startDate = [RCTAppleHealthKit dateFromOptions:input key:@"startDate" withDefault:nil];
+    NSDate *endDate = [RCTAppleHealthKit dateFromOptions:input key:@"endDate" withDefault:nil];
+    NSString *valueString = [[RCTAppleHealthKit stringFromOptions:input key:@"value" withDefault:@"ASLEEP"] uppercaseString];
+    NSDictionary *metadata = [RCTAppleHealthKit metadataFromOptions:input withDefault:nil];
+
+    if(startDate == nil || endDate == nil){
+        callback(@[RCTMakeError(@"startDate and endDate are required in options", nil, nil)]);
+        return;
+    }
+
+    if([endDate timeIntervalSinceDate:startDate] <= 0){
+        callback(@[RCTMakeError(@"endDate must be later than startDate", nil, nil)]);
+        return;
+    }
+
+    HKCategoryType *sleepType = [HKObjectType categoryTypeForIdentifier:HKCategoryTypeIdentifierSleepAnalysis];
+    NSInteger sleepValue = HKCategoryValueSleepAnalysisAsleep;
+
+    if([valueString isEqualToString:@"INBED"]){
+        sleepValue = HKCategoryValueSleepAnalysisInBed;
+    } else if([valueString isEqualToString:@"AWAKE"]){
+        sleepValue = HKCategoryValueSleepAnalysisAwake;
+    } else if(@available(iOS 16.0, *)) {
+        if([valueString isEqualToString:@"CORE"]){
+            sleepValue = HKCategoryValueSleepAnalysisAsleepCore;
+        } else if([valueString isEqualToString:@"DEEP"]){
+            sleepValue = HKCategoryValueSleepAnalysisAsleepDeep;
+        } else if([valueString isEqualToString:@"REM"]){
+            sleepValue = HKCategoryValueSleepAnalysisAsleepREM;
+        }
+    }
+
+    HKCategorySample *sample = [HKCategorySample categorySampleWithType:sleepType
+                                                                 value:sleepValue
+                                                             startDate:startDate
+                                                               endDate:endDate
+                                                              metadata:metadata];
+
+    [self.healthStore saveObject:sample withCompletion:^(BOOL success, NSError *error) {
+        if(!success){
+            callback(@[RCTJSErrorFromNSError(error)]);
+            return;
+        }
+
+        NSDictionary *response = @{
+            @"startDate": [RCTAppleHealthKit buildISO8601StringFromDate:startDate],
+            @"endDate": [RCTAppleHealthKit buildISO8601StringFromDate:endDate],
+            @"value": valueString ?: @"ASLEEP"
+        };
+        callback(@[[NSNull null], response]);
+    }];
+}
+
 
 @end
