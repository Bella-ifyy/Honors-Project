{
  "name": "workout",
  "version": "1.0.1",
  "scripts": {
    "ci": "watchman watch-del-all && rm -rf node_modules && yarn install --frozen-lockfile",
    "prestart": "watchman watch-del-all",
    "start": "expo start --dev-client",
    "start:dev": "NODE_ENV=development npx expo start -c",
    "android": "expo run:android",
    "android:dev": "NODE_ENV=development npx expo start --android",
    "ios": "expo run:ios",
    "icons": "node ./scripts/generate-icons.js",
    "eas-build": "npx eas build -p ios --clear-cache",
    "eas-build-ios-submit": "npx eas build -p ios --auto-submit --clear-cache",
    "eas-build-android-submit": "npx eas build -p android --auto-submit --clear-cache",
    "ios:dev": "NODE_ENV=development npx expo start --ios",
    "web": "NODE_ENV=production npx expo start --web",
    "web:dev": "NODE_ENV=development npx expo start --web",
    "format": "prettier --config .prettierrc src/**/*.{ts,tsx} --write",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest --verbose --passWithNoTests",
    "test:watch": "jest --verbose --passWithNoTests --watch",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "burnt": "^0.13.0",
    "@expo/metro-runtime": "~3.2.3",
    "@gorhom/bottom-sheet": "^5",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/drawer": "^6.6.15",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@reduxjs/toolkit": "^2.2.3",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "axios": "^1.7.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^51.0.20",
    "expo-asset": "~10.0.10",
    "expo-av": "~14.0.7",
    "expo-blur": "~13.0.3",
    "expo-constants": "^16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-device": "~5.0.0",
    "expo-font": "~12.0.4",
    "expo-image": "~1.13.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-local-authentication": "^14.0.1",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.4",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "~0.25.28",
    "expo-web-browser": "^13.0.3",
    "formik": "^2.4.6",
    "lucide-react-native": "^0.456.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-alert-notification": "^0.4.0",
    "react-native-config": "^1.5.2",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-input-select": "^2.1.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-health": "^1.11.0",
    "react-native-modal": "^13.0.1",
    "react-native-pell-rich-editor": "^1.9.0",
    "react-native-quick-base64": "^2.1.2",
    "react-native-reanimated": "~3.10.1",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-select-dropdown": "^4.0.1",
    "react-native-svg": "15.2.0",
    "react-native-svg-charts": "^5.4.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "~0.19.11",
    "react-native-webview": "13.8.2",
    "react-redux": "^9.1.2",
    "redux-logger": "^3.0.6",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.3.0",
    "@types/redux-logger": "^3.0.13",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^12.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.1",
    "lint-staged": "^15.2.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "sharp": "^0.34.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "private": true,
  "packageManager": "yarn@1.22.22"
}
